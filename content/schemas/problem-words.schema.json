{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-words.schema.json",
  "title": "Mots des problèmes Educator",
  "description": "Prénoms (variés, non stéréotypés), objets et contenants tirés au hasard dans les énoncés de problèmes (SUB000124).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "names",
    "objects",
    "containers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "names": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "feminine"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "feminine": {
            "type": "boolean",
            "description": "true : « elle »."
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "singular",
          "plural"
        ],
        "properties": {
          "singular": {
            "type": "string",
            "minLength": 1
          },
          "plural": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "containers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "singular",
          "plural"
        ],
        "properties": {
          "singular": {
            "type": "string",
            "minLength": 1
          },
          "plural": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
