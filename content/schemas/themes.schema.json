{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "themes.schema.json",
  "title": "Thèmes de l'application",
  "description": "Chaque thème a un bloc [data-theme=\"id\"] dans web/src/styles.css ; « sport » est obligatoire (thème par défaut).",
  "type": "object",
  "additionalProperties": false,
  "required": ["themes"],
  "properties": {
    "$schema": { "type": "string" },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    }
  }
}
