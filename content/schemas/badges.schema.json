{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "badges.schema.json",
  "title": "Badges",
  "description": "Badges gagnés par l'enfant (SUB001503). La condition est vérifiée à la fin de chaque séance ; un badge gagné est gardé.",
  "type": "object",
  "additionalProperties": false,
  "required": ["badges"],
  "properties": {
    "$schema": { "type": "string" },
    "badges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "icon", "condition"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1, "description": "Nom du badge affiché à l'enfant." },
          "description": { "type": "string", "minLength": 1, "description": "La condition dite simplement, affichée sous un badge à gagner." },
          "icon": { "type": "string", "pattern": "^badges/[a-z0-9-]+\\.svg$" },
          "condition": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "skills", "minScore"],
                "properties": {
                  "type": { "const": "skillMastery" },
                  "skills": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Une de ces compétences maîtrisée (au moins 10 réponses)." },
                  "minScore": { "type": "integer", "minimum": 1, "maximum": 100 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "category", "count", "minScore"],
                "properties": {
                  "type": { "const": "categoryMastery" },
                  "category": {
                    "enum": ["numbers", "addSubtract", "multiply", "fractionsHalves", "problems", "lettersAndSounds", "spellingRules", "silentLetters", "agreement", "wordsToKnow"]
                  },
                  "count": { "type": "integer", "minimum": 1 },
                  "minScore": { "type": "integer", "minimum": 1, "maximum": 100 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "count"],
                "properties": {
                  "type": { "const": "seriesCompleted" },
                  "count": { "type": "integer", "minimum": 1 },
                  "subject": { "enum": ["math", "spelling"] }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "count"],
                "properties": {
                  "type": { "enum": ["perfectSeries", "activeDays", "lessonsFinished", "stars"] },
                  "count": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "days"],
                "properties": {
                  "type": { "const": "goalStreak" },
                  "days": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "level"],
                "properties": {
                  "type": { "const": "level" },
                  "level": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
