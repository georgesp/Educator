{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accessories.schema.json",
  "title": "Accessoires de l'avatar",
  "description": "SUB001504. Chaque accessoire est un SVG sans id ni texte, coloré par var(--acc) et var(--acc-light) ; son point « anchor » est posé sur le point d'ancrage de son emplacement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["colors", "accessories"],
  "properties": {
    "$schema": { "type": "string" },
    "comment": { "type": "string" },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "main", "light"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "main": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "light": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    },
    "accessories": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "slot", "file", "anchor", "colors", "unlock"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "slot": { "enum": ["head", "eyes", "neck", "companion"] },
          "layer": { "enum": ["front", "back"], "description": "« back » : dessiné derrière le personnage (cape)." },
          "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.svg$" },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "colors": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Couleurs proposées, la première par défaut." },
          "unlock": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "level": { "type": "integer", "minimum": 1 },
              "badge": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
