{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-templates.schema.json",
  "title": "Gabarits de problèmes Educator",
  "description": "Gabarits d'énoncés (SUB000124) : les nombres sont tirés au hasard dans leurs plages et vérifiés par les conditions ; les prénoms et objets viennent de words.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "variables",
        "answer",
        "solution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "partWhole",
            "transformation",
            "comparison",
            "twoSteps",
            "product",
            "sharing",
            "mixed"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Énoncé avec {a}, {name}, {name2}, {il}, {Il}, {il2}, {Il2}, {ils}, {object}, {objects}, {container}, {containers}."
        },
        "variables": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min"
            ],
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "description": "Par défaut : la taille des nombres de la compétence (maxNumber)."
              }
            }
          }
        },
        "derived": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "description": "Expression entière : nombres, variables, + − × ÷ (ou + - * /) et parenthèses."
          },
          "description": "Valeurs intermédiaires calculées (utilisables dans le texte)."
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Condition vraie pour garder le tirage (a < c, s <= max)."
          }
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "description": "Expression entière : nombres, variables, + − × ÷ (ou + - * /) et parenthèses."
        },
        "solution": {
          "type": "string",
          "minLength": 1,
          "description": "Correction affichée après une erreur, avec {answer}."
        },
        "mistakes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Expression entière : nombres, variables, + − × ÷ (ou + - * /) et parenthèses."
          },
          "description": "Erreurs typiques proposées en QCM (mauvaise opération, une seule étape)."
        },
        "help": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "bars"
              ],
              "properties": {
                "bars": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Expression entière : nombres, variables, + − × ÷ (ou + - * /) et parenthèses."
                    }
                  }
                },
                "total": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Expression entière : nombres, variables, + − × ÷ (ou + - * /) et parenthèses."
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "groups",
                "perGroup"
              ],
              "properties": {
                "groups": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Expression entière : nombres, variables, + − × ÷ (ou + - * /) et parenthèses."
                },
                "perGroup": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Expression entière : nombres, variables, + − × ÷ (ou + - * /) et parenthèses."
                }
              }
            }
          ],
          "description": "Schéma montré avec la correction : barres (barModel) ou groupes."
        },
        "grades": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CP",
              "CE1",
              "CE2",
              "CM1",
              "CM2"
            ]
          },
          "description": "Classes qui utilisent le gabarit ; absent : toutes. Les gabarits du CP disent « fois » au lieu de ×."
        }
      }
    }
  }
}
