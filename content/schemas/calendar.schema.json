{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calendar.schema.json",
  "title": "Périodes de l'année scolaire",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "periods"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "periods": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "Début de chaque période, de 1 à 5, dans l'ordre de l'année scolaire.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period",
          "month",
          "day"
        ],
        "properties": {
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          }
        }
      }
    }
  }
}
