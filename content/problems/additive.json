{
  "$schema": "../schemas/problem-templates.schema.json",
  "templates": [
    {
      "id": "part-whole-total",
      "kind": "partWhole",
      "text": "{name} a {a} {objects} dans une boîte et {b} dans un sac. Combien de {objects} {name} a-t-{il} en tout ?",
      "variables": {
        "a": {
          "min": 2
        },
        "b": {
          "min": 2
        }
      },
      "answer": "a + b",
      "solution": "{a} + {b} = {answer}. {name} a {answer} {objects}.",
      "mistakes": [
        "a - b",
        "b - a"
      ],
      "help": {
        "bars": [
          [
            "a",
            "b"
          ]
        ],
        "total": "answer"
      }
    },
    {
      "id": "part-whole-part",
      "kind": "partWhole",
      "text": "{name} a {c} {objects}. {a} sont dans une boîte, les autres sont dans un sac. Combien de {objects} sont dans le sac ?",
      "variables": {
        "c": {
          "min": 10
        },
        "a": {
          "min": 2
        }
      },
      "checks": [
        "a < c"
      ],
      "answer": "c - a",
      "solution": "{c} − {a} = {answer}. Il y a {answer} {objects} dans le sac.",
      "mistakes": [
        "c + a"
      ],
      "help": {
        "bars": [
          [
            "a",
            "answer"
          ]
        ],
        "total": "c"
      }
    },
    {
      "id": "part-whole-school",
      "kind": "partWhole",
      "text": "Dans l'école, il y a {a} filles et {b} garçons. Combien d'élèves y a-t-il en tout ?",
      "variables": {
        "a": {
          "min": 10
        },
        "b": {
          "min": 10
        }
