      "text": "{name} a {a} {objects}. {Il} en perd {b} à la récréation. Combien de {objects} lui reste-t-il ?",
      "variables": {
        "a": {
          "min": 5
        },
        "b": {
          "min": 2
        }
      },
      "checks": [
        "b < a"
      ],
      "answer": "a - b",
      "solution": "{a} − {b} = {answer}. Il reste {answer} {objects} à {name}.",
      "mistakes": [
        "a + b"
      ],
      "help": {
        "bars": [
          [
            "answer",
            "b"
          ]
        ],
        "total": "a"
      }
    },
