    {
      "id": "comparison-inverse",
      "kind": "comparison",
      "text": "{name} a {a} {objects}. C'est {b} de plus que {name2}. Combien de {objects} {name2} a-t-{il2} ?",
      "variables": {
        "a": {
          "min": 8
        },
        "b": {
          "min": 2
        }
      },
      "checks": [
        "b < a"
      ],
      "answer": "a - b",
      "solution": "{name} en a {b} de plus, donc {name2} en a moins : {a} − {b} = {answer}.",
      "mistakes": [
        "a + b"
      ],
      "help": {
        "bars": [
          [
            "answer",
            "b"
          ],
          [
