## -------------------------------------------------------
## .gitignore — Educator (Rust / Tauri 2 / React)
## -------------------------------------------------------

# ========================
# Front (Node / Vite)
# ========================
node_modules/
web/dist/
*.tsbuildinfo
npm-debug.log*
.vite/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ========================
# Tauri / Rust
# ========================
# Workspace Cargo à la racine (lot 1bis) ; l'ancien dossier de la coque seule reste ignoré.
/target/
web/src-tauri/target/
# Schémas générés par Tauri au build
web/src-tauri/gen/

# ========================
# Piper (binaires et voix téléchargés par script, jamais commités)
# ========================
vendor/piper/
# Audio of the spelling words, pre-generated by scripts/generate-word-audio (SUB001404), embedded at build
content/audio/

# ========================
# IDE
# ========================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# ========================
# macOS
# ========================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# ========================
# Windows
# ========================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ========================
# Secrets
# ========================
secrets.json
*.pfx
*.p12
*.p8
*.key
*.cer
*.mobileprovision
.env
.env.*
!.env.example

# ========================
# Tests
# ========================
TestResults/
coverage/
*.coverage
*.coveragexml
lcov.info

# ========================
# SQLite (bases locales)
# ========================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ========================
# Fichiers temporaires
# ========================
*.tmp
*.temp
*.bak
*.swp
*~
