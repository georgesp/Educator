## -------------------------------------------------------
## .gitignore — Educator (Rust / Tauri 2 / React)
## -------------------------------------------------------

# ========================
# Front (Node / Vite)
# ========================
node_modules/
web/dist/
*.tsbuildinfo
npm-debug.log*
.vite/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ========================
# Tauri / Rust
# ========================
# Workspace Cargo à la racine (lot 1bis) ; l'ancien dossier de la coque seule reste ignoré.
/target/
web/src-tauri/target/
# Schémas générés par Tauri au build ; le projet Xcode (gen/apple) est commité (ADR 0006),
# ses sorties de build sont ignorées par le .gitignore que Tauri crée dans gen/apple.
web/src-tauri/gen/schemas/
# Copie de content/ refaite par chaque build iOS (ressource de l'application)
web/src-tauri/gen/apple/assets/

# ========================
# Piper (binaires et voix téléchargés par script, jamais commités)
# ========================
vendor/piper/

# ========================
# IDE
# ========================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# ========================
# macOS
# ========================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# ========================
# Windows
# ========================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ========================
# Secrets
# ========================
secrets.json
*.pfx
*.p12
*.p8
*.key
*.cer
*.mobileprovision
.env
.env.*
!.env.example

# ========================
# Tests
# ========================
TestResults/
coverage/
*.coverage
*.coveragexml
lcov.info

# ========================
# SQLite (bases locales)
# ========================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ========================
# Fichiers temporaires
# ========================
*.tmp
*.temp
*.bak
*.swp
*~
