<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Pedagogical content loading and validation (JSON rules, words, lessons, SVG) and Piper speech synthesis.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Educator.Core\Educator.Core.csproj" />
  </ItemGroup>

  <!-- The pedagogical content (repository root) is copied next to every assembly that references this project. -->
  <ItemGroup>
    <Content Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Educator.Content.Tests" />
  </ItemGroup>

</Project>
